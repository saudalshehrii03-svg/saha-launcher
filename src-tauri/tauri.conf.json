{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Saha",
  "version": "0.1.0",
  "identifier": "app.saha.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "ساحة · Saha", "width": 1440, "height": 900, "minWidth": 1100, "minHeight": 700 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
