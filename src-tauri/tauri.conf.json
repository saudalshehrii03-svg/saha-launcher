{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Saha",
  "version": "0.2.1",
  "identifier": "app.saha.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ساحة · Saha",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "maximized": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPCONFIG/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk3OTMzREFFQzlENEJGQzYKUldUR3Y5VEpyajJUbC9nd2FmM3l4Umc4aDdOekFWd3phQ0FsK3J1T0Q4Q2JHd3FhY2VKLy83cngK",
      "endpoints": [
        "https://github.com/saudalshehrii03-svg/saha-launcher/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "nxm"
        ]
      }
    }
  }
}
